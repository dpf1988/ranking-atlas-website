---
// HandUnderline — a rough, hand-drawn yellow stroke under a single word.
// Sits under one noun inside a hub H1. Amber #C08A1F, reused from the
// logo mark. The SVG stretches to the wrapped word's width via
// preserveAspectRatio="none" on a viewBox with room to render the stroke.
---

<span class="relative inline-block">
  <slot />
  <svg
    viewBox="0 0 220 12"
    preserveAspectRatio="none"
    class="absolute left-0 right-0 -bottom-1 md:-bottom-2 w-full h-[10px] md:h-[12px] pointer-events-none"
    aria-hidden="true"
  >
    <path
      d="M4 7 C 40 3, 80 10, 120 5 S 190 9, 216 4"
      stroke="#C08A1F"
      stroke-width="3"
      stroke-linecap="round"
      fill="none"
    />
  </svg>
</span>
