---
import Layout from '../layouts/Layout.astro';
import PrimaryCTA from '../components/PrimaryCTA.astro';

const featuredResearch = [
  {
    href: "/resources/generational-fraud",
    eyebrow: "Data Report",
    title: "Who Actually Gets Scammed in America?",
    description: "Federal fraud and survey data show sharp divides in who gets scammed, how often, and how much they lose.",
  },
  {
    href: "/resources/ai-names-ict-experts",
    eyebrow: "Data Report",
    title: "One Woman for Every Ten: How AI Names the Experts in Tech",
    description: "2,286 individuals extracted from 2,520 AI responses across ChatGPT, Claude, Gemini, and Perplexity. Women made up 20.5% of named ICT experts against a 28% workforce baseline.",
  },
  {
    href: "/resources/saas-pricing-inflation",
    eyebrow: "Data Report",
    title: "Welcome to the SaaSpocalypse",
    description: "Software that can be vibe-coded by a small team has lost all pricing power, while AI-resistant SaaS categories raised entry-tier prices up to three times faster than inflation.",
  },
];

// Editorial eyebrow — pill with navy dot.
const eyebrow = "inline-flex items-center px-3 py-1.5 rounded-full bg-accent-bright/15 border border-accent-bright/40 mb-5";
const eyebrowText = "text-[11px] uppercase tracking-[0.14em] font-semibold text-ink";

---

<Layout
  title="Ranking Atlas — Editorial campaigns built on original research and data"
  description="Ranking Atlas produces commissioned studies, proprietary data analysis, and editorial campaigns used by publishers, journalists, and brands seeking broader visibility online."
>

  <!-- ── 1. HERO ── editorial pill + asymmetric layout with right-side study card -->
  <section id="home" class="pt-28 md:pt-32 lg:pt-36 pb-8 md:pb-10 relative" style="background-image: linear-gradient(to right, rgba(15,27,61,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(15,27,61,0.04) 1px, transparent 1px); background-size: 48px 48px;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-end">
        <div class="lg:col-span-6">
          <div class="inline-flex items-center px-3 py-1.5 rounded-full bg-accent-bright/15 border border-accent-bright/40 mb-7">
            <span class="text-[11px] uppercase tracking-[0.14em] font-semibold text-ink">Digital PR for the AI era</span>
          </div>
          <h1 class="font-serif font-medium text-[2.5rem] sm:text-[3.5rem] lg:text-[4.75rem] tracking-[-0.02em] text-ink leading-[1.02] mb-7">
            <span class="brush-underline"><em class="italic font-normal text-ink" style="font-family: 'Instrument Serif', 'Source Serif 4', Georgia, serif;">Make AI</em> Recommend Your Brand.</span>
          </h1>
          <p class="font-sans font-normal text-[18px] md:text-[20px] text-ink leading-snug mb-8 max-w-[560px]">
            We place your company in <strong class="font-semibold">the publications LLMs cite</strong>, so you get more leads from AI and Google.
          </p>
          <div class="flex flex-wrap items-center gap-5">
            <PrimaryCTA href="/contact" />
            <a href="/resources" class="group text-sm font-semibold text-brand hover:text-brand-dark tracking-tight inline-flex items-center gap-1.5">
              See the research
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </div>
        </div>

        <!-- Right-side: fanned stack of three real placements. Auto-shuffles
             every 4.5s on desktop; static on mobile (only Metro visible).
             Pauses on hover. Respects prefers-reduced-motion. -->
        <div class="lg:col-span-6 lg:-mr-6 xl:-mr-12 relative">
          <div class="fan-container relative aspect-[6/5]">
            <!-- Card 0: Forbes (initial front, LCP-critical, always visible on mobile) -->
            <a href="https://www.forbes.com/sites/christopherelliott/2026/08/07/wildfires-travel-when-to-cancel-vacation/" target="_blank" rel="noopener" aria-label="Read on Forbes" data-fan-card class="fan-card fan-front group absolute top-0 left-1/2 w-full md:w-[76%] aspect-[6/5]">
              <article class="h-full rounded-md border border-ink/10 shadow-[0_30px_60px_-15px_rgba(15,27,61,0.28),0_10px_25px_-10px_rgba(15,27,61,0.18)] overflow-hidden bg-white flex flex-col">
                <header class="flex items-center px-4 py-2 bg-bg-paper border-b border-ink/[0.08]">
                  <span class="font-serif font-semibold text-[13px] text-ink tracking-tight">Forbes</span>
                </header>
                <div class="flex-1 overflow-hidden">
                  <img src="/images/forbes.webp" alt="Ranking Atlas research featured in Forbes: wildfires and travel" class="w-full h-full object-cover object-left-top" fetchpriority="high" />
                </div>
              </article>
            </a>

            <!-- Card 1: This Is Money (initial back-right) -->
            <a href="https://www.thisismoney.co.uk/money/buytolet/article-15968671/Seven-ten-landlords-say-no-pets-despite-new-rules-heres-hardest-pet-friendly-home.html" target="_blank" rel="noopener" aria-label="Read on This Is Money" data-fan-card class="fan-card fan-back-right group hidden md:block absolute top-0 left-1/2 w-[76%] aspect-[6/5]">
              <article class="h-full rounded-md border border-ink/10 shadow-[0_20px_40px_-15px_rgba(15,27,61,0.28)] overflow-hidden bg-white flex flex-col">
                <header class="flex items-center px-4 py-2 bg-bg-paper border-b border-ink/[0.08]">
                  <span class="font-serif font-semibold text-[13px] text-ink tracking-tight">This Is Money</span>
                </header>
                <div class="flex-1 overflow-hidden">
                  <img src="/images/thisismoney-pets.webp" alt="Ranking Atlas research featured in This Is Money: seven in ten landlords still say no to pets" class="w-full h-full object-cover object-top" loading="lazy" />
                </div>
              </article>
            </a>

            <!-- Card 2: Metro (initial back-left) -->
            <a href="https://metro.co.uk/2026/07/16/london-neighbourhood-house-prices-fell-97-500-despite-hs2-hopes-29136202/" target="_blank" rel="noopener" aria-label="Read on Metro" data-fan-card class="fan-card fan-back-left group hidden md:block absolute top-0 left-1/2 w-[76%] aspect-[6/5]">
              <article class="h-full rounded-md border border-ink/10 shadow-[0_20px_40px_-15px_rgba(15,27,61,0.28)] overflow-hidden bg-white flex flex-col">
                <header class="flex items-center px-4 py-2 bg-bg-paper border-b border-ink/[0.08]">
                  <span class="font-serif font-semibold text-[13px] text-ink tracking-tight">Metro</span>
                </header>
                <div class="flex-1 overflow-hidden">
                  <img src="/images/metro-hs2.webp" alt="Ranking Atlas analysis featured in Metro: Old Oak Common house prices fell £97,500 despite HS2 hopes" class="w-full h-full object-cover object-top" loading="lazy" />
                </div>
              </article>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 1b. READ IN ── static grid of press placements, unified typographic
       treatment. Each cell is a real coverage link. Instrument Serif italic
       across the whole strip for consistency (no mixed SVG/text). Hairline
       grid, 4-across desktop / 2-across mobile. -->
  <section class="bg-white border-y border-ink/10 py-8 md:py-10">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-[10px] uppercase tracking-[0.22em] text-muted font-semibold text-center mb-6">Featured in</p>
      <div class="overflow-hidden" style="mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);">
        <div class="motion-safe:animate-marquee-slow flex items-center gap-x-10 md:gap-x-14 w-max py-1">
          <!-- Copy 1 -->
          <a href="https://metro.co.uk/2026/07/16/london-neighbourhood-house-prices-fell-97-500-despite-hs2-hopes-29136202/" target="_blank" rel="noopener" class="shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage in Metro">
            <img src="/assets/images/press-logos/metro.svg" alt="Metro" class="h-5 md:h-6 object-contain" />
          </a>
          <a href="https://theintermediary.co.uk/2026/07/hs2-land-value-uplift-real-but-uneven-ranking-atlas-finds/" target="_blank" rel="noopener" class="shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage in The Intermediary">
            <img src="/assets/images/press-logos/intermediary.png" alt="The Intermediary" class="h-5 md:h-6 object-contain" />
          </a>
          <a href="https://www.birminghammail.co.uk/whats-on/whats-on-news/andy-burnham-expected-pledge-1027bn-34281766" target="_blank" rel="noopener" class="shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage in Birmingham Live">
            <img src="/assets/images/press-logos/birmingham-live.svg" alt="Birmingham Live" class="h-5 md:h-6 object-contain" />
          </a>
          <a href="https://www.coventrytelegraph.net/news/local-news/hs2-revival-andy-burnhams-1027bn-34285597" target="_blank" rel="noopener" class="shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage in Coventry Live">
            <img src="/assets/images/press-logos/coventry-live.svg" alt="Coventry Live" class="h-5 md:h-6 object-contain" />
          </a>
          <a href="https://www.forbes.com/sites/christopherelliott/2026/08/07/wildfires-travel-when-to-cancel-vacation/" target="_blank" rel="noopener" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage in Forbes">
            <span class="font-serif font-bold text-[17px] md:text-[20px] whitespace-nowrap text-ink tracking-tight italic">Forbes</span>
          </a>
          <a href="https://www.thisismoney.co.uk/money/buytolet/article-15968671/Seven-ten-landlords-say-no-pets-despite-new-rules-heres-hardest-pet-friendly-home.html" target="_blank" rel="noopener" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage in This is Money">
            <span class="font-serif font-semibold text-[13px] md:text-[15px] whitespace-nowrap text-ink tracking-tight">This is Money</span>
          </a>
          <a href="https://www.yorkshirepost.co.uk/news/transport/hs2-land-value-around-norths-train-stations-could-fund-rail-projects-8799288" target="_blank" rel="noopener" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage in Yorkshire Post">
            <span class="font-serif font-semibold text-[13px] md:text-[15px] whitespace-nowrap text-ink tracking-tight">Yorkshire Post</span>
          </a>
          <a href="https://www.blackpoolgazette.co.uk/news/just-28-of-blackpool-rentals-allow-pets-despite-new-law-8791797" target="_blank" rel="noopener" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage in Blackpool Gazette">
            <span class="font-serif font-semibold text-[13px] md:text-[15px] whitespace-nowrap text-ink tracking-tight">Blackpool Gazette</span>
          </a>
          <a href="https://www.msn.com/en-za/news/other/seven-in-ten-landlords-say-no-to-pets-despite-new-renters-rights-act-rules/ar-AA27EtF3" target="_blank" rel="noopener" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300" aria-label="Ranking Atlas coverage on MSN">
            <span class="font-serif font-semibold text-[13px] md:text-[15px] whitespace-nowrap text-ink tracking-tight">MSN</span>
          </a>

          <!-- Copy 2: duplicated for seamless marquee loop. aria-hidden + tabindex=-1
               keep it out of screen-reader flow and tab order, but mouse users
               still get hover + click when the duplicate is on screen.
               Hidden entirely under reduced motion (no loop, no need for it). -->
          <div aria-hidden="true" class="motion-reduce:hidden flex items-center gap-x-10 md:gap-x-14 shrink-0">
            <a href="https://metro.co.uk/2026/07/16/london-neighbourhood-house-prices-fell-97-500-despite-hs2-hopes-29136202/" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-300">
              <img src="/assets/images/press-logos/metro.svg" alt="" class="h-5 md:h-6 object-contain" />
            </a>
            <a href="https://theintermediary.co.uk/2026/07/hs2-land-value-uplift-real-but-uneven-ranking-atlas-finds/" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-300">
              <img src="/assets/images/press-logos/intermediary.png" alt="" class="h-5 md:h-6 object-contain" />
            </a>
            <a href="https://www.birminghammail.co.uk/whats-on/whats-on-news/andy-burnham-expected-pledge-1027bn-34281766" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-300">
              <img src="/assets/images/press-logos/birmingham-live.svg" alt="" class="h-5 md:h-6 object-contain" />
            </a>
            <a href="https://www.coventrytelegraph.net/news/local-news/hs2-revival-andy-burnhams-1027bn-34285597" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition duration-300">
              <img src="/assets/images/press-logos/coventry-live.svg" alt="" class="h-5 md:h-6 object-contain" />
            </a>
            <a href="https://www.forbes.com/sites/christopherelliott/2026/08/07/wildfires-travel-when-to-cancel-vacation/" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300">
              <span class="font-serif font-bold text-[17px] md:text-[20px] whitespace-nowrap text-ink tracking-tight italic">Forbes</span>
            </a>
            <a href="https://www.thisismoney.co.uk/money/buytolet/article-15968671/Seven-ten-landlords-say-no-pets-despite-new-rules-heres-hardest-pet-friendly-home.html" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300">
              <span class="font-serif font-semibold text-[13px] md:text-[15px] whitespace-nowrap text-ink tracking-tight">This is Money</span>
            </a>
            <a href="https://www.yorkshirepost.co.uk/news/transport/hs2-land-value-around-norths-train-stations-could-fund-rail-projects-8799288" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300">
              <span class="font-serif font-semibold text-[13px] md:text-[15px] whitespace-nowrap text-ink tracking-tight">Yorkshire Post</span>
            </a>
            <a href="https://www.blackpoolgazette.co.uk/news/just-28-of-blackpool-rentals-allow-pets-despite-new-law-8791797" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300">
              <span class="font-serif font-semibold text-[13px] md:text-[15px] whitespace-nowrap text-ink tracking-tight">Blackpool Gazette</span>
            </a>
            <a href="https://www.msn.com/en-za/news/other/seven-in-ten-landlords-say-no-to-pets-despite-new-renters-rights-act-rules/ar-AA27EtF3" target="_blank" rel="noopener" tabindex="-1" class="shrink-0 opacity-60 hover:opacity-100 transition duration-300">
              <span class="font-serif font-semibold text-[13px] md:text-[15px] whitespace-nowrap text-ink tracking-tight">MSN</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. THE PROBLEM ── left/right split: framing on left, vertical list on right -->
  <section class="bg-bg-warm py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-16 gap-y-10">
        <!-- LEFT: eyebrow + H2 + standfirst + method note tail -->
        <div class="lg:col-span-5">
          <div class={eyebrow}>
            <span class={eyebrowText}>The problem</span>
          </div>
          <h2 class="font-serif font-semibold text-2xl md:text-3xl tracking-tight text-ink leading-tight mb-5"><span class="brush-underline">The issues<br />Ranking Atlas solves:</span></h2>
          <p class="font-serif italic text-[19px] leading-snug text-body max-w-[440px] mt-6">
            Most digital PR sells volume. Ranking Atlas measures the outcome.
          </p>
          <p class="mt-8 pt-6 border-t border-ink/10 max-w-[440px] text-[13px] text-muted italic leading-relaxed">
            Method note: the full case for citation equity as the primary metric of AI-era visibility lives in our <a href="/blog/citation-equity" class="not-italic font-medium text-brand hover:text-brand-dark underline underline-offset-2 decoration-brand/30 hover:decoration-brand transition-colors">citation essay study</a>.
          </p>
        </div>

        <!-- RIGHT: vertical list of 3 problem beats, hairline-separated -->
        <div class="lg:col-span-7">
          <ol class="divide-y divide-ink/12 border-y border-ink/12">
            <li class="flex items-start gap-6 py-7">
              <img src="/assets/images/authority-icons/05-scales-transparent.png" alt="" aria-hidden="true" class="w-14 h-14 shrink-0 object-contain" loading="lazy" />
              <div>
                <h3 class="font-serif text-lg md:text-xl font-medium tracking-tight text-ink leading-snug mb-2">Traditional PR doesn't measure AI answers.</h3>
                <p class="text-[15px] text-body leading-relaxed">You get no visibility data on ChatGPT, Perplexity, or Gemini.</p>
              </div>
            </li>
            <li class="flex items-start gap-6 py-7">
              <img src="/assets/images/authority-icons/08-compass-transparent.png" alt="" aria-hidden="true" class="w-14 h-14 shrink-0 object-contain" loading="lazy" />
              <div>
                <h3 class="font-serif text-lg md:text-xl font-medium tracking-tight text-ink leading-snug mb-2">SEO agencies chase rankings AI is eating.</h3>
                <p class="text-[15px] text-body leading-relaxed">Their KPI is a Google ranking fewer buyers ever look at.</p>
              </div>
            </li>
            <li class="flex items-start gap-6 py-7">
              <img src="/assets/images/authority-icons/06-archive-transparent.png" alt="" aria-hidden="true" class="w-14 h-14 shrink-0 object-contain" loading="lazy" />
              <div>
                <h3 class="font-serif text-lg md:text-xl font-medium tracking-tight text-ink leading-snug mb-2">Syndication tools inflate arbitrary link counts.</h3>
                <p class="text-[15px] text-body leading-relaxed">Expensive volume metrics that don't influence editorial authority.</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3. WHAT WE DO ── manifesto: 3 pillars with role-specific icons, hairline dividers -->
  <section class="py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-14 max-w-[720px]">
        <div class={eyebrow}>
          <span class={eyebrowText}>What we do</span>
        </div>
        <h2 class="font-serif font-semibold text-2xl md:text-3xl tracking-tight text-ink leading-tight mb-5"><span class="brush-underline">Research, editorial placements, visibility measurement</span></h2>
        <p class="font-serif italic text-[19px] leading-snug text-body max-w-[560px]">
          The studio runs on three functions. Each is measured. Each compounds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-12">
        <div class="md:pr-8 flex flex-col">
          <div class="w-16 h-16 rounded-md bg-bg-warm flex items-center justify-center mb-5">
            <img src="/assets/images/authority-icons/04-stamped-doc-transparent.png" alt="" aria-hidden="true" class="w-14 h-14" />
          </div>
          <h3 class="font-serif text-xl md:text-[1.375rem] font-medium tracking-tight text-ink leading-snug mb-4">We publish primary data.</h3>
          <ul class="space-y-2 text-[15px] text-body leading-relaxed mb-6">
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>FOI campaigns</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Proprietary data analysis</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Data scraping stories</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Primary-source analysis</span></li>
          </ul>
          <div class="mt-auto pt-4 border-t border-ink/10">
            <div class="text-[10px] uppercase tracking-[0.14em] text-muted font-semibold mb-1.5">Latest study</div>
            <p class="text-[13px] text-body leading-snug">Who Actually Gets Scammed in America, generational fraud analysis.</p>
          </div>
        </div>
        <div class="md:px-8 md:border-l md:border-ink/12 flex flex-col">
          <div class="w-16 h-16 rounded-md bg-bg-warm flex items-center justify-center mb-5">
            <img src="/assets/images/authority-icons/02-column-transparent.png" alt="" aria-hidden="true" class="w-14 h-14" />
          </div>
          <h3 class="font-serif text-xl md:text-[1.375rem] font-medium tracking-tight text-ink leading-snug mb-4">We place it in the press.</h3>
          <ul class="space-y-2 text-[15px] text-body leading-relaxed mb-6">
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Report published</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Targeted journalist outreach</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Placement and pickup tracking</span></li>
          </ul>
          <div class="mt-auto pt-4 border-t border-ink/10">
            <div class="text-[10px] uppercase tracking-[0.14em] text-muted font-semibold mb-1.5">Recent pickup</div>
            <p class="text-[13px] text-body leading-snug">HS2 land-value analysis: Metro, Yorkshire Post, The Intermediary.</p>
          </div>
        </div>
        <div class="md:pl-8 md:border-l md:border-ink/12 flex flex-col">
          <div class="w-16 h-16 rounded-md bg-bg-warm flex items-center justify-center mb-5">
            <img src="/assets/images/authority-icons/08-compass-transparent.png" alt="" aria-hidden="true" class="w-14 h-14" />
          </div>
          <h3 class="font-serif text-xl md:text-[1.375rem] font-medium tracking-tight text-ink leading-snug mb-4">We track where you appear.</h3>
          <ul class="space-y-2 text-[15px] text-body leading-relaxed mb-6">
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Documented baseline</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Prompt-level tracking</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Branded vs non-branded splits</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Competitor benchmarking</span></li>
          </ul>
          <div class="mt-auto pt-4 border-t border-ink/10">
            <div class="text-[10px] uppercase tracking-[0.14em] text-muted font-semibold mb-1.5">Engines tracked</div>
