      setTimeout(() => el.scrollIntoView({ behavior: 'smooth' }), 100);
    }
  }
</script>

<script>
  (function () {
    const carousel = document.getElementById('press-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.press-slide');
    const dots = carousel.querySelectorAll('.press-dot');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer = null;

    function goTo(index) {
      slides.forEach((s, i) => {
        const active = i === index;
        s.style.opacity = active ? '1' : '0';
        s.style.zIndex = active ? '10' : '0';
        if (reducedMotion) s.style.transitionDuration = '0s';
      });
      dots.forEach((d, i) => {
        if (i === index) {
          d.className = 'press-dot w-2 h-2 rounded-full bg-[#1E3A8A] transition-colors';
        } else {
          d.className = 'press-dot w-2 h-2 rounded-full bg-[#0A0F1E]/20 hover:bg-[#0A0F1E]/40 transition-colors';
        }
      });
      current = index;
    }

    function startTimer() {
      if (reducedMotion) return;
      timer = setInterval(function () {
        goTo((current + 1) % slides.length);
      }, 4000);
    }

    function stopTimer() {
      clearInterval(timer);
    }

    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        stopTimer();
        goTo(Number(d.dataset.dot));
        startTimer();
      });
    });

    carousel.addEventListener('mouseenter', stopTimer);
    carousel.addEventListener('mouseleave', startTimer);

    startTimer();
  })();
</script>

