---
import Layout from '../layouts/Layout.astro';

const featuredResearch = [
  {
    href: "/resources/generational-fraud",
    eyebrow: "Data Report",
    title: "Who Actually Gets Scammed in America?",
    description: "Federal fraud and survey data show sharp divides in who gets scammed, how often, and how much they lose.",
  },
  {
    href: "/resources/ai-names-ict-experts",
    eyebrow: "Data Report",
    title: "One Woman for Every Ten: How AI Names the Experts in Tech",
    description: "2,286 individuals extracted from 2,520 AI responses across ChatGPT, Claude, Gemini, and Perplexity. Women made up 20.5% of named ICT experts against a 28% workforce baseline.",
  },
  {
    href: "/resources/saas-pricing-inflation",
    eyebrow: "Data Report",
    title: "Welcome to the SaaSpocalypse",
    description: "Software that can be vibe-coded by a small team has lost all pricing power, while AI-resistant SaaS categories raised entry-tier prices up to three times faster than inflation.",
  },
];

// Editorial eyebrow — pill with navy dot.
const eyebrow = "inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-bright/15 border border-accent-bright/40 mb-5";
const eyebrowDot = "h-1.5 w-1.5 rounded-full bg-brand";
const eyebrowText = "text-[11px] uppercase tracking-[0.14em] font-semibold text-ink";

// Restrained CTAs — administrative, not conversion-aggressive.
const primaryCta = "inline-flex items-center justify-center bg-brand hover:bg-brand-dark text-white font-semibold px-5 py-2.5 rounded text-sm shadow-[0_3px_8px_-2px_rgba(15,27,61,0.22),0_1px_2px_rgba(15,27,61,0.10)] hover:shadow-[0_6px_14px_-4px_rgba(15,27,61,0.28),0_2px_4px_-1px_rgba(15,27,61,0.12)] hover:-translate-y-px transition-all duration-200";
const secondaryCta = "inline-flex items-center justify-center bg-bg-warm hover:bg-white text-ink font-semibold tracking-tight px-5 py-2.5 rounded border border-ink/15 text-sm shadow-[0_3px_8px_-2px_rgba(15,27,61,0.14),0_1px_2px_rgba(15,27,61,0.06)] hover:shadow-[0_6px_14px_-4px_rgba(15,27,61,0.18),0_2px_4px_-1px_rgba(15,27,61,0.08)] hover:-translate-y-px transition-all duration-200";
---

<Layout
  title="Ranking Atlas — Editorial campaigns built on original research and data"
  description="Ranking Atlas produces commissioned studies, proprietary data analysis, and editorial campaigns used by publishers, journalists, and brands seeking broader visibility online."
>

  <!-- ── 1. HERO ── editorial pill + asymmetric layout with right-side study card -->
  <section id="home" class="pt-28 md:pt-32 lg:pt-36 pb-16 md:pb-20 relative" style="background-image: linear-gradient(to right, rgba(15,27,61,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(15,27,61,0.04) 1px, transparent 1px); background-size: 48px 48px;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-6">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-bright/15 border border-accent-bright/40 mb-7">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-ink shrink-0">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
            <span class="text-[11px] uppercase tracking-[0.14em] font-semibold text-ink">Digital PR for the AI era</span>
          </div>
          <h1 class="font-serif font-light text-[2.5rem] sm:text-[3.5rem] lg:text-[4.75rem] tracking-[-0.02em] text-ink leading-[1.02] mb-7">
            <span class="brush-underline"><em class="italic font-normal text-ink" style="font-family: 'Instrument Serif', 'Source Serif 4', Georgia, serif;">Show Up</em> in AI Answers.</span>
          </h1>
          <p class="font-serif text-[19px] md:text-[22px] text-ink leading-snug mb-8 max-w-[560px]">
            Ranking Atlas places your company in the publications LLMs cite, so you get more leads from AI and Google.
          </p>
          <div class="flex flex-wrap items-center gap-5">
            <a href="/contact" class={primaryCta}>Book a Call</a>
            <a href="/resources" class="group text-sm font-semibold text-brand hover:text-brand-dark tracking-tight inline-flex items-center gap-1.5">
              See the research
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </a>
          </div>
        </div>

        <!-- Right-side: press coverage carousel with mock browser frames -->
        <div class="lg:col-span-6 lg:-mt-8 lg:-mr-6 xl:-mr-12 relative">
          <div id="press-carousel" class="rounded-xl border border-ink/10 shadow-[0_30px_60px_-15px_rgba(15,27,61,0.25),0_10px_25px_-10px_rgba(15,27,61,0.15)] overflow-hidden bg-white">
            <div class="relative aspect-[6/5]">
              <!-- Slide 1: Metro (visible by default for no-JS graceful degradation / LCP) -->
              <a href="https://metro.co.uk/2026/07/16/london-neighbourhood-house-prices-fell-97-500-despite-hs2-hopes-29136202/" target="_blank" rel="noopener" class="press-slide absolute inset-0 flex flex-col opacity-100 z-10 transition-opacity duration-700" data-slide="0" aria-label="Read on Metro">
                <div class="flex items-center px-3 py-2 bg-bg-paper border-b border-ink/[0.08]">
                  <div class="flex gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                  </div>
                  <div class="flex-1 flex justify-center">
                    <span class="text-[11px] text-muted font-medium px-3 py-0.5 rounded-full bg-ink/[0.04]">metro.co.uk</span>
                  </div>
                  <div class="w-[54px]"></div>
                </div>
                <div class="flex-1 overflow-hidden">
                  <img src="/images/metro-hs2.webp" alt="Ranking Atlas analysis featured in Metro: Old Oak Common house prices fell £97,500 despite HS2 hopes" class="w-full h-full object-cover object-top" fetchpriority="high" />
                </div>
              </a>
              <!-- Slide 2: The Intermediary -->
              <a href="https://theintermediary.co.uk/2026/07/hs2-land-value-uplift-real-but-uneven-ranking-atlas-finds/" target="_blank" rel="noopener" class="press-slide absolute inset-0 flex flex-col opacity-0 z-0 transition-opacity duration-700" data-slide="1" aria-label="Read on The Intermediary">
                <div class="flex items-center px-3 py-2 bg-bg-paper border-b border-ink/[0.08]">
                  <div class="flex gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                  </div>
                  <div class="flex-1 flex justify-center">
                    <span class="text-[11px] text-muted font-medium px-3 py-0.5 rounded-full bg-ink/[0.04]">theintermediary.co.uk</span>
                  </div>
                  <div class="w-[54px]"></div>
                </div>
                <div class="flex-1 overflow-hidden">
                  <img src="/images/intermediary-hs2.webp" alt="Ranking Atlas HS2 land value analysis covered in The Intermediary" class="w-full h-full object-cover object-left-top" loading="lazy" />
                </div>
              </a>
              <!-- Slide 3: This Is Money -->
              <a href="https://www.thisismoney.co.uk/money/buytolet/article-15968671/Seven-ten-landlords-say-no-pets-despite-new-rules-heres-hardest-pet-friendly-home.html" target="_blank" rel="noopener" class="press-slide absolute inset-0 flex flex-col opacity-0 z-0 transition-opacity duration-700" data-slide="2" aria-label="Read on This Is Money">
                <div class="flex items-center px-3 py-2 bg-bg-paper border-b border-ink/[0.08]">
                  <div class="flex gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-ink/10"></span>
                  </div>
                  <div class="flex-1 flex justify-center">
                    <span class="text-[11px] text-muted font-medium px-3 py-0.5 rounded-full bg-ink/[0.04]">thisismoney.co.uk</span>
                  </div>
                  <div class="w-[54px]"></div>
                </div>
                <div class="flex-1 overflow-hidden">
                  <img src="/images/thisismoney-pets.webp" alt="Ranking Atlas research featured in This Is Money: seven in ten landlords still say no to pets despite new rules" class="w-full h-full object-cover object-top" loading="lazy" />
                </div>
              </a>
            </div>
            <!-- Dot indicators -->
            <div class="flex justify-center gap-2 py-3 bg-white">
              <button class="press-dot w-2 h-2 rounded-full bg-brand transition-colors" data-dot="0" aria-label="Show Metro slide"></button>
              <button class="press-dot w-2 h-2 rounded-full bg-ink/20 hover:bg-ink/40 transition-colors" data-dot="1" aria-label="Show The Intermediary slide"></button>
              <button class="press-dot w-2 h-2 rounded-full bg-ink/20 hover:bg-ink/40 transition-colors" data-dot="2" aria-label="Show This Is Money slide"></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 1b. FEATURED IN ── press logo strip: real branded logos + styled text fallbacks -->
  <section class="bg-white border-y border-ink/10 py-8 md:py-10">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-[10px] uppercase tracking-[0.22em] text-muted font-semibold text-center mb-6">Featured in</p>
      <div class="flex flex-nowrap items-center justify-between gap-x-5 md:gap-x-7 text-ink overflow-x-auto md:overflow-visible">
        <img src="/assets/images/press-logos/metro.svg" alt="Metro" class="h-4 md:h-5 shrink-0 opacity-70 hover:opacity-100 transition-opacity" />
        <img src="/assets/images/press-logos/intermediary.png" alt="The Intermediary" class="h-7 md:h-9 shrink-0 opacity-70 hover:opacity-100 transition-opacity object-contain" />
        <img src="/assets/images/press-logos/birmingham-live.svg" alt="Birmingham Live" class="h-5 md:h-6 shrink-0 opacity-70 hover:opacity-100 transition-opacity" />
        <img src="/assets/images/press-logos/coventry-live.svg" alt="Coventry Live" class="h-5 md:h-6 shrink-0 opacity-70 hover:opacity-100 transition-opacity" />
        <span class="font-serif italic text-[0.9rem] md:text-[1rem] shrink-0 whitespace-nowrap text-ink/70 hover:text-ink transition-colors tracking-tight">This is Money</span>
        <span class="font-serif font-semibold text-[0.9rem] md:text-[1rem] shrink-0 whitespace-nowrap text-ink/70 hover:text-ink transition-colors tracking-tight">Yorkshire Post</span>
        <span class="font-serif font-semibold text-[0.9rem] md:text-[1rem] shrink-0 whitespace-nowrap text-ink/70 hover:text-ink transition-colors tracking-tight">Blackpool Gazette</span>
        <span class="font-sans font-bold text-[0.9rem] md:text-[1rem] shrink-0 whitespace-nowrap text-ink/70 hover:text-ink transition-colors tracking-tight">MSN</span>
      </div>
    </div>
  </section>

  <!-- ── 2. THE PROBLEM ── left/right split: framing on left, vertical list on right -->
  <section class="bg-bg-warm py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-16 gap-y-10">
        <!-- LEFT: eyebrow + H2 + descriptive framing -->
        <div class="lg:col-span-5">
          <div class={eyebrow}>
            <span aria-hidden="true" class={eyebrowDot}></span>
            <span class={eyebrowText}>The problem</span>
          </div>
          <h2 class="font-serif font-semibold text-2xl md:text-3xl tracking-tight text-ink leading-tight mb-5"><span class="brush-underline">Three issues<br />Ranking Atlas solves</span></h2>
        </div>

        <!-- RIGHT: vertical list of 3 problem beats, hairline-separated -->
        <div class="lg:col-span-7">
          <ol class="divide-y divide-ink/12 border-y border-ink/12">
            <li class="flex gap-6 py-7">
              <div class="font-serif text-[2rem] md:text-[2.25rem] font-semibold text-brand/35 leading-none shrink-0 w-14">01</div>
              <div>
                <h3 class="font-serif text-lg md:text-xl font-medium tracking-tight text-ink leading-snug mb-2">Traditional PR doesn't measure AI answers.</h3>
                <p class="text-[15px] text-body leading-relaxed">You get no visibility data on ChatGPT, Perplexity, or Gemini.</p>
              </div>
            </li>
            <li class="flex gap-6 py-7">
              <div class="font-serif text-[2rem] md:text-[2.25rem] font-semibold text-brand/35 leading-none shrink-0 w-14">02</div>
              <div>
                <h3 class="font-serif text-lg md:text-xl font-medium tracking-tight text-ink leading-snug mb-2">SEO agencies chase rankings AI is eating.</h3>
                <p class="text-[15px] text-body leading-relaxed">Their KPI is a Google ranking fewer buyers ever look at.</p>
              </div>
            </li>
            <li class="flex gap-6 py-7">
              <div class="font-serif text-[2rem] md:text-[2.25rem] font-semibold text-brand/35 leading-none shrink-0 w-14">03</div>
              <div>
                <h3 class="font-serif text-lg md:text-xl font-medium tracking-tight text-ink leading-snug mb-2">Syndication tools inflate arbitrary link counts.</h3>
                <p class="text-[15px] text-body leading-relaxed">Expensive volume metrics that don't influence editorial authority.</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3. WHAT WE DO ── manifesto: 3 pillars with role-specific icons, hairline dividers -->
  <section class="py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-14">
        <div class={eyebrow}>
          <span aria-hidden="true" class={eyebrowDot}></span>
          <span class={eyebrowText}>What we do</span>
        </div>
        <h2 class="font-serif font-semibold text-2xl md:text-3xl tracking-tight text-ink leading-tight mb-5"><span class="brush-underline">Research, editorial placements, visibility measurement</span></h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-12">
        <div class="md:pr-8">
          <div class="w-16 h-16 rounded-md bg-bg-warm flex items-center justify-center mb-5">
            <img src="/assets/images/authority-icons/04-stamped-doc-transparent.png" alt="" aria-hidden="true" class="w-14 h-14" />
          </div>
          <h3 class="font-serif text-xl md:text-[1.375rem] font-medium tracking-tight text-ink leading-snug mb-4">Original Research</h3>
          <ul class="space-y-2 text-[15px] text-body leading-relaxed">
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>FOI campaigns</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Proprietary data analysis</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Data scraping stories</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Primary-source analysis</span></li>
          </ul>
        </div>
        <div class="md:px-8 md:border-l md:border-ink/12">
          <div class="w-16 h-16 rounded-md bg-bg-warm flex items-center justify-center mb-5">
            <img src="/assets/images/authority-icons/02-column-transparent.png" alt="" aria-hidden="true" class="w-14 h-14" />
          </div>
          <h3 class="font-serif text-xl md:text-[1.375rem] font-medium tracking-tight text-ink leading-snug mb-4">Editorial Production</h3>
          <ul class="space-y-2 text-[15px] text-body leading-relaxed">
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Report published</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Targeted journalist outreach</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Placement and pickup tracking</span></li>
          </ul>
        </div>
        <div class="md:pl-8 md:border-l md:border-ink/12">
          <div class="w-16 h-16 rounded-md bg-bg-warm flex items-center justify-center mb-5">
            <img src="/assets/images/authority-icons/08-compass-transparent.png" alt="" aria-hidden="true" class="w-14 h-14" />
          </div>
          <h3 class="font-serif text-xl md:text-[1.375rem] font-medium tracking-tight text-ink leading-snug mb-4">Visibility Measurement</h3>
          <ul class="space-y-2 text-[15px] text-body leading-relaxed">
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Documented baseline</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Prompt-level tracking</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Branded vs non-branded splits</span></li>
            <li class="flex items-start gap-3"><span class="inline-block w-3 h-px bg-accent mt-[0.7em] shrink-0" aria-hidden="true"></span><span>Competitor benchmarking</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 4. FEATURED RESEARCH ── flagship + 2 secondary, study metadata pills -->
  <section class="bg-bg-warm py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
        <div class="max-w-[640px]">
          <div class={eyebrow}>
            <span aria-hidden="true" class={eyebrowDot}></span>
            <span class={eyebrowText}>Research</span>
          </div>
          <h2 class="font-serif font-semibold text-2xl md:text-3xl tracking-tight text-ink leading-tight mb-4"><span class="brush-underline">Featured Research</span></h2>
        </div>
        <a href="/resources" class="text-sm text-brand hover:text-brand-dark font-semibold shrink-0">
          View all research →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- Flagship -->
        <a href={featuredResearch[0].href} class="group lg:col-span-7 bg-white border border-ink/12 rounded-md p-10 md:p-12 hover:border-ink/25 transition-colors flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-[10px] uppercase tracking-[0.16em] text-brand font-semibold">Featured Study</span>
            <span aria-hidden="true" class="h-px w-8 bg-brand/40"></span>
            <span class="text-[10px] uppercase tracking-[0.14em] text-muted font-medium">{featuredResearch[0].eyebrow}</span>
          </div>
          <h3 class="font-serif font-semibold text-2xl md:text-[2rem] tracking-tight text-ink mb-5 leading-[1.2] group-hover:text-brand-navy transition-colors max-w-[560px]">
            {featuredResearch[0].title}
          </h3>
          <p class="text-base md:text-lg text-body leading-relaxed mb-6 max-w-[540px]">
            {featuredResearch[0].description}
          </p>

          <!-- Subtle table preview from the study -->
          <figure class="mb-7 max-w-[560px]">
            <figcaption class="flex items-center gap-2 mb-2.5">
              <span class="text-[10px] uppercase tracking-[0.14em] text-muted font-semibold">Index preview</span>
              <span aria-hidden="true" class="h-px flex-1 bg-ink/10"></span>
              <span class="text-[10px] uppercase tracking-[0.14em] text-muted font-medium">Composite score</span>
            </figcaption>
            <div class="rounded-sm border border-ink/10 bg-white p-5 space-y-3" role="figure" aria-label="Index preview: composite scores by age cohort">
              <div class="flex items-center gap-3">
                <span class="w-4 text-[11px] font-semibold text-ink text-right">1</span>
                <span class="w-24 shrink-0 text-[12.5px] font-semibold text-ink">Ages 50–64</span>
                <div class="flex-1 h-2 rounded-full bg-ink/[0.06] overflow-hidden">
                  <div class="h-full w-[84.6%] bg-brand rounded-full"></div>
                </div>
                <span class="w-10 text-right text-[13px] font-bold text-brand">84.6</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-4 text-[11px] font-medium text-body text-right">2</span>
                <span class="w-24 shrink-0 text-[12.5px] font-medium text-body">Ages 25–34</span>
                <div class="flex-1 h-2 rounded-full bg-ink/[0.06] overflow-hidden">
                  <div class="h-full w-[60.4%] bg-brand/55 rounded-full"></div>
                </div>
                <span class="w-10 text-right text-[13px] font-medium text-body">60.4</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-4 text-[11px] font-medium text-body text-right">3</span>
                <span class="w-24 shrink-0 text-[12.5px] font-medium text-body">Ages 35–49</span>
                <div class="flex-1 h-2 rounded-full bg-ink/[0.06] overflow-hidden">
                  <div class="h-full w-[52.4%] bg-brand/50 rounded-full"></div>
                </div>
                <span class="w-10 text-right text-[13px] font-medium text-body">52.4</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-4 text-[11px] font-medium text-muted text-right">4</span>
                <span class="w-24 shrink-0 text-[12.5px] font-medium text-muted">Ages 65+</span>
                <div class="flex-1 h-2 rounded-full bg-ink/[0.06] overflow-hidden">
                  <div class="h-full w-[51.4%] bg-brand/45 rounded-full"></div>
                </div>
                <span class="w-10 text-right text-[13px] font-medium text-muted">51.4</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-4 text-[11px] font-medium text-muted text-right">5</span>
                <span class="w-24 shrink-0 text-[12.5px] font-medium text-muted">Ages 18–24</span>
                <div class="flex-1 h-2 rounded-full bg-ink/[0.06] overflow-hidden">
                  <div class="h-full w-[12.4%] bg-brand/30 rounded-full"></div>
                </div>
                <span class="w-10 text-right text-[13px] font-medium text-muted">12.4</span>
              </div>
            </div>
          </figure>

          <div class="flex flex-wrap gap-1.5 mb-7">
            <span class="text-[10px] uppercase tracking-[0.1em] px-2 py-1 rounded-sm bg-white border border-ink/10 text-body font-medium">6 federal sources</span>
