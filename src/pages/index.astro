<script>
  // Hero fan-card auto-shuffle: rotates which of the three placement cards
  // occupies front / back-left / back-right every 4.5s. Desktop only.
  // Pauses on hover of the fan container. Disabled under reduced-motion.
  (() => {
    const container = document.querySelector('.fan-container');
    if (!container) return;
    const cards = container.querySelectorAll('[data-fan-card]');
    if (cards.length !== 3) return;

    const desktopMq = window.matchMedia('(min-width: 768px)');
    const motionMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const positions = ['fan-front', 'fan-back-right', 'fan-back-left'];
    let step = 0;
    let interval: number | null = null;

    function apply() {
      cards.forEach((card, i) => {
        const pos = positions[(i + step) % 3];
        card.classList.remove('fan-front', 'fan-back-left', 'fan-back-right');
        card.classList.add(pos);
      });
    }

    function start() {
      if (interval !== null) return;
      if (!desktopMq.matches || motionMq.matches) return;
      interval = window.setInterval(() => { step = (step + 1) % 3; apply(); }, 4500);
    }
    function stop() {
      if (interval !== null) { clearInterval(interval); interval = null; }
    }

    container.addEventListener('mouseenter', stop);
    container.addEventListener('mouseleave', start);
    desktopMq.addEventListener('change', () => { stop(); start(); });
    motionMq.addEventListener('change', () => { stop(); start(); });

    start();
  })();
</script>

<style>
  /* Hero fanned-card stack. Shared positioning; per-position transform layer. */
  .fan-card {
    transform-origin: center bottom;
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
                opacity 900ms ease,
                box-shadow 900ms ease;
    will-change: transform, opacity;
  }
  .fan-card.fan-front {
    transform: translate(-50%, 0) rotate(0deg) scale(1);
    z-index: 30;
    opacity: 1;
  }
  .fan-card.fan-back-left {
    transform: translate(calc(-50% - 20%), 4%) rotate(-5deg) scale(0.95);
    z-index: 10;
    opacity: 0.82;
  }
  .fan-card.fan-back-right {
    transform: translate(calc(-50% + 20%), 4%) rotate(5deg) scale(0.95);
    z-index: 20;
    opacity: 0.9;
  }
  @media (prefers-reduced-motion: reduce) {
    .fan-card { transition: none; }
  }
</style>


