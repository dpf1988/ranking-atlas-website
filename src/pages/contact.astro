---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import Eyebrow from '../components/Eyebrow.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Ranking Atlas",
  "url": "https://ranking-atlas.com/contact",
  "description": "Start an editorial campaign with Ranking Atlas. Get in touch to discuss your market, visibility goals, and research brief.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Ranking Atlas",
    "url": "https://ranking-atlas.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "contact@ranking-atlas.com",
      "contactType": "sales",
      "availableLanguage": "English"
    }
  }
};
---

<Layout
  title="Contact — Ranking Atlas"
  description="Start an editorial campaign with Ranking Atlas. Get in touch to discuss your market, visibility goals, and research brief."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero + form (side by side on desktop) -->
  <section class="pt-32 pb-16 md:pt-44 md:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- LEFT: hero copy -->
        <div class="lg:pt-4">
          <Eyebrow label="Book a Call" />
          <h1 class="font-serif font-light text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] tracking-tight text-ink leading-[1.05] mb-6">
            <span class="brush-underline"><em class="italic font-normal text-ink" style="font-family: 'Instrument Serif', 'Source Serif 4', Georgia, serif;">Show Up</em> in AI Answers.</span>
          </h1>
          <p class="text-lg md:text-xl text-body leading-relaxed">
            Tell us about your business and who your customers are. We'll have an audit and plan ready for you on the sales call.
          </p>
          <p class="mt-5 italic text-base text-muted leading-relaxed">
            A single campaign starts at £4.5k. Programmes run in successive campaigns over months.
          </p>
        </div>

        <!-- RIGHT: form -->
        <div>
          <ContactForm />
        </div>

      </div>
    </div>
  </section>
</Layout>
