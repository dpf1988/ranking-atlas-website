---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Ranking Atlas",
  "url": "https://ranking-atlas.com",
  "description": "Ranking Atlas is a digital PR studio built for the AI search era. We earn editorial coverage for brands that want to be cited when buyers ask LLMs which product to trust."
};

const primaryCta = "inline-flex items-center justify-center bg-[#1E3A8A] hover:bg-[#1E40AF] text-white font-semibold px-5 py-2.5 rounded text-sm shadow-[0_3px_8px_-2px_rgba(15,27,61,0.22),0_1px_2px_rgba(15,27,61,0.10)] hover:shadow-[0_6px_14px_-4px_rgba(15,27,61,0.28),0_2px_4px_-1px_rgba(15,27,61,0.12)] hover:-translate-y-px transition-all duration-200";
---

<Layout
  title="About — Ranking Atlas"
  description="Ranking Atlas is a digital PR studio built for the AI search era. We earn editorial coverage for brands that want to be cited when buyers ask LLMs which product to trust."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Hero -->
  <section class="pt-28 md:pt-36 pb-16 md:pb-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-[11px] uppercase tracking-[0.22em] text-brand font-semibold mb-5">About</p>
      <h1 class="font-serif font-light text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] tracking-tight text-ink leading-[1.1] mb-6">
        A digital PR studio built for the<br />AI search era.
      </h1>
      <p class="text-lg md:text-xl text-body leading-relaxed max-w-2xl mx-auto">
        Ranking Atlas earns editorial coverage for brands that want to be cited when buyers ask LLMs which product to trust.
      </p>
    </div>
  </section>

  <!-- Our story -->
  <section class="py-16 md:py-20 bg-[#FBFAF7] border-y border-[#0A0F1E]/[0.06]">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-semibold text-2xl md:text-3xl tracking-tight text-ink leading-tight mb-6">Our story</h2>
      <div class="space-y-5 text-[17px] md:text-lg text-body leading-relaxed">
        <p>
          Ranking Atlas answers a shift in how modern buyers find brands.
        </p>
        <p>
          Search behaviour has completely changed, moving from clicking links in Google SERPs to reading answers written by AI.
        </p>
        <p>
          To get your brand cited in those AI answers, you need authoritative third-party coverage.
        </p>
        <p>
          We design original data studies, place them in those third-party publications, and measure the movement in AI visibility that follows. Every engagement runs against a documented baseline and competitor benchmark, so the impact is visible, not asserted.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-24 bg-[#FBFAF7]">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-serif font-semibold text-2xl md:text-3xl tracking-tight text-ink leading-tight mb-5">
        Ready to be the answer?
      </h2>
      <p class="text-lg text-body leading-relaxed mb-8 max-w-xl mx-auto">
        Tell us about your business and who your customers are. We'll have an audit and plan ready for you on the call.
      </p>
      <div class="flex justify-center">
        <a href="/contact" class={primaryCta}>Book a Call</a>
      </div>
    </div>
  </section>

</Layout>
