---
// Category listing page under /data/<category>/. Generated for every
// populated category. Datasets stay flat at /data/<slug>, so this page is a
// pure filter/index — no dataset URL churns.

import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import DatasetCard from '../../../components/datalibrary/DatasetCard.astro';

const DATASET_ROOT = path.resolve(process.cwd(), 'datalibrary', 'datasets');

const CATEGORY_ORDER = ['economy', 'health', 'society', 'environment', 'technology', 'property'] as const;
type Category = typeof CATEGORY_ORDER[number];
const CATEGORY_META: Record<Category, { label: string; standfirst: string }> = {
  economy:     { label: 'Economy',     standfirst: 'Incomes, growth, prices, trade, labour, and fiscal indicators, ranked across every country with published data.' },
  health:      { label: 'Health',      standfirst: 'Life expectancy, mortality, disease burden, and healthcare capacity, ranked across every country with published data.' },
  society:     { label: 'Society',     standfirst: 'Demographics, education, inequality, culture, and migration, ranked across every country with published data.' },
  environment: { label: 'Environment', standfirst: 'Emissions, energy, land use, climate, and natural resources, ranked across every country with published data.' },
  technology:  { label: 'Technology',  standfirst: 'AI adoption, digital infrastructure, R&D, and innovation output, ranked across every country with published data.' },
  property:    { label: 'Property',    standfirst: 'House prices, transaction volumes, rents, and land value, ranked across every market with published data.' },
};

interface DatasetCardData {
  slug: string;
  category: Category;
  title: string;
  summary: string;
  metaLine: string;
  publishedISO: string;
}

function firstSentence(s: string): string {
  const m = s.match(/^[^.!?]+[.!?]/);
  return m ? m[0].trim() : s.trim();
}

function loadAll(): DatasetCardData[] {
  const cards: DatasetCardData[] = [];
  if (!fs.existsSync(DATASET_ROOT)) return cards;
  for (const name of fs.readdirSync(DATASET_ROOT)) {
    const cfgPath = path.join(DATASET_ROOT, name, 'config.json');
    const dataPath = path.join(DATASET_ROOT, name, 'data.json');
    if (!fs.existsSync(cfgPath) || !fs.existsSync(dataPath)) continue;
    const cfg = JSON.parse(fs.readFileSync(cfgPath, 'utf-8'));
    const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
    if (!CATEGORY_ORDER.includes(cfg.category)) continue;
    const m = data.metrics;
    const firstYear = data.temporalCoverage?.startYear ?? m.firstYear ?? 0;
    const latestYear = m.latestYear ?? 0;

    const tokens: Record<string, string> = { firstYear: String(firstYear), latestYear: String(latestYear) };
    const sub = (s: string) => s.replace(/\{\{(\w+)\}\}/g, (_, k) => tokens[k] ?? '');
    const shortTitle = sub(cfg.shortTitle || cfg.title || name);

    const summary = (cfg.card_summary && String(cfg.card_summary)) ||
                    (cfg.definition ? firstSentence(String(cfg.definition)) : '');

    const sourceName = cfg.sourceName || data.source?.name || '';
    const reportingEconomies = m.reportingEconomiesLatest ?? 0;
    const metaLine = `${sourceName} · ${reportingEconomies} countries · ${firstYear}\u2013${latestYear}`;

    cards.push({
      slug: name,
      category: cfg.category as Category,
      title: `${shortTitle}, ${firstYear}\u2013${latestYear}`,
      summary,
      metaLine,
      publishedISO: cfg.byline?.publishedISO ?? data.retrievedAt ?? '',
    });
  }
  return cards;
}

export async function getStaticPaths() {
  const CATS = ['economy', 'health', 'society', 'environment', 'technology', 'property'];
  const root = path.resolve(process.cwd(), 'datalibrary', 'datasets');
  if (!fs.existsSync(root)) return [];
  const populated = new Set<string>();
  for (const name of fs.readdirSync(root)) {
    const cfgPath = path.join(root, name, 'config.json');
    const dataPath = path.join(root, name, 'data.json');
    if (!fs.existsSync(cfgPath) || !fs.existsSync(dataPath)) continue;
    const cfg = JSON.parse(fs.readFileSync(cfgPath, 'utf-8'));
    if (CATS.includes(cfg.category)) populated.add(cfg.category);
  }
  return [...populated].map(category => ({ params: { category } }));
}

const { category } = Astro.params;
const cat = category as Category;
const meta = CATEGORY_META[cat];
const cards = loadAll()
  .filter(c => c.category === cat)
  .sort((a, b) => (b.publishedISO || '').localeCompare(a.publishedISO || ''));

const canonicalUrl = `https://ranking-atlas.com/data/${cat}`;

const orgAuthor = { '@type': 'Organization', 'name': 'Ranking Atlas', 'url': 'https://ranking-atlas.com' };
const jsonLdGraph: any[] = [
  {
    '@type': 'CollectionPage',
    'name': `${meta.label} datasets`,
    'url': canonicalUrl,
    'publisher': orgAuthor,
    'mainEntity': {
      '@type': 'ItemList',
      'numberOfItems': cards.length,
      'itemListElement': cards.map((c, i) => ({
        '@type': 'ListItem',
        'position': i + 1,
        'item': {
          '@type': 'Dataset',
          'name': c.title,
          'description': c.summary,
          'url': `https://ranking-atlas.com/data/${c.slug}`,
          'creator': orgAuthor,
          'publisher': orgAuthor,
          'datePublished': c.publishedISO,
        },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://ranking-atlas.com/' },
      { '@type': 'ListItem', 'position': 2, 'name': 'Data', 'item': 'https://ranking-atlas.com/data' },
      { '@type': 'ListItem', 'position': 3, 'name': meta.label, 'item': canonicalUrl },
    ],
  },
];
const jsonLd = { '@context': 'https://schema.org', '@graph': jsonLdGraph };
---

<Layout
  title={`${meta.label} datasets | Ranking Atlas`}
  description={meta.standfirst}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <link rel="canonical" href={canonicalUrl} slot="head" />

  <section class="py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-6">

      <nav class="text-[13px] text-muted mb-5" aria-label="Breadcrumb">
        <a href="/" class="text-muted hover:text-brand transition-colors">Home</a>
        <span class="mx-2 text-[#B6C0D2]">/</span>
        <a href="/data" class="text-muted hover:text-brand transition-colors">Data</a>
        <span class="mx-2 text-[#B6C0D2]">/</span>
        <span>{meta.label}</span>
      </nav>

      <div class="mb-12">
        <h1 class="font-serif font-medium text-[2rem] md:text-[2.75rem] tracking-tight text-ink leading-[1.05] mb-5">
          {meta.label} datasets
        </h1>
        <p class="text-lg text-body leading-relaxed max-w-3xl">
          {meta.standfirst}
        </p>
      </div>

      {cards.length === 0 ? (
        <div class="bg-white rounded-md shadow-card border border-ink/8 p-10 text-body">
          No datasets in this category yet.
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {cards.map((c) => (
            <DatasetCard
              href={`/data/${c.slug}`}
              title={c.title}
              summary={c.summary}
              metaLine={c.metaLine}
            />
          ))}
        </div>
      )}

      <div class="mt-16 pt-8 border-t border-ink/8">
        <a href="/data" class="text-[14px] font-semibold text-brand hover:text-brand-dark underline underline-offset-2">← All categories</a>
      </div>

    </div>
  </section>

</Layout>
