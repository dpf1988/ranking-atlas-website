const url = "https://ranking-atlas.com/blog/verify-digital-pr-agency-results";
const pubDate = "2026-09-06";
const updatedDate = "2026-09-06";

const article = articleSchema({
  title: "How to Verify a Digital PR Agency's Results Before You Sign",
  description: "Seven checks to make before paying a digital PR agency: the story, the list, the pitch, the timing, the journalist, the URLs, and the measurement.",
  url,
  datePublished: pubDate,
  dateModified: updatedDate,
});

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: "https://ranking-atlas.com/" },
  { name: "Blog", url: "https://ranking-atlas.com/blog/" },
  { name: "How to Verify a Digital PR Agency's Results", url },
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What should you ask a digital PR agency before signing?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ask for the proposed story as a headline, the journalists targeted and the reason for each, a pitch the agency has sent and the coverage it produced, the send schedule, the process for answering journalists, live URLs for recent placements with link status marked, and the measurement framework, including a baseline captured before the campaign starts." }
    },
    {
      "@type": "Question",
      "name": "How do you verify a digital PR placement?",
      "acceptedAnswer": { "@type": "Answer", "text": "Open the URL. Confirm it is original editorial rather than syndication, sponsored content, a guest post, or paid placement. Confirm the client is named. Confirm whether there is a link, whether it is dofollow or nofollow, and which page it points to. Confirm nothing was paid or exchanged for it. Count syndicated copies of one article as one placement." }
    },
    {
      "@type": "Question",
      "name": "Should a digital PR agency guarantee placements?",
      "acceptedAnswer": { "@type": "Answer", "text": "A guaranteed number of placements is common and workable, provided the contract defines what counts and the agency's pitch volume is realistic for the number. A guarantee of coverage in a specific named publication is different. No agency controls an editor's decisions, so a named-title guarantee is either a paid placement described as earned, or a promise the agency cannot keep." }
    },
    {
      "@type": "Question",
      "name": "How long does it take for coverage to land?",
      "acceptedAnswer": { "@type": "Answer", "text": "A single data-led campaign typically runs two to three weeks from first send to the end of follow-up, with coverage arriving unevenly across that window and occasionally for weeks after. The effect on search and AI visibility compounds across successive campaigns over months, which is why a baseline matters. Without one there is no way to distinguish movement from noise." }
    },
    {
      "@type": "Question",
      "name": "Is a mention without a link worth anything?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, and less than a link. Editorial mentions in relevant, independently published sources can contribute to the external evidence available to search and AI systems when they assess a brand, whether or not the mention contains a link. For search authority, the link still matters. The problem is not unlinked mentions. It is agencies reporting them as if they were linked placements." }
    },
    {
      "@type": "Question",
      "name": "Why do journalists ignore pitches?",
      "acceptedAnswer": { "@type": "Answer", "text": "Because most pitches deserve it. A reporter's inbox holds more pitches than there are hours to read them, and most are commentary offers, template subject lines, or stories sent to the wrong desk. The pitches that get opened are specific to the recipient, lead with a finding and a number, and arrive when the desk is planning. That is a description of work, and it is the work a buyer should be paying an agency to do." }
    },
  ]
};
