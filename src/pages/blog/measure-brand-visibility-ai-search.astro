  { name: "Home", url: "https://ranking-atlas.com/" },
  { name: "Blog", url: "https://ranking-atlas.com/blog/" },
  { name: "How to Measure Brand Visibility in ChatGPT and AI Search", url },
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How often should the prompt set run?",
      "acceptedAnswer": { "@type": "Answer", "text": "Monthly at minimum for a programme, weekly if you are actively campaigning or in a volatile category. Less than monthly and the trend line takes too long to mean anything." }
    },
    {
      "@type": "Question",
      "name": "Can this be done manually or does it need tooling?",
      "acceptedAnswer": { "@type": "Answer", "text": "Fifty prompts across four engines is a disciplined afternoon by hand, monthly, and the spreadsheet structure is sufficient. Tooling buys cadence, scale and competitor depth. Method first, tooling second: a tool producing a blended score fails this methodology regardless of price." }
    },
    {
      "@type": "Question",
      "name": "Why do results differ between engines?",
      "acceptedAnswer": { "@type": "Answer", "text": "Different retrieval blends: each engine mixes live search, licensed feeds and its own weighting differently, so the retrieved set differs and the synthesis with it. That variance is signal, not noise; it tells you which engine's trusted sources you are missing from." }
    },
    {
      "@type": "Question",
      "name": "What is a good non-branded visibility rate?",
      "acceptedAnswer": { "@type": "Answer", "text": "There is no universal benchmark, which is precisely why the baseline and the competitor set matter: the honest question is your rate against your named competitors on your buyers' prompts, trending which direction. Categories vary too much for a global number to mean anything, and anyone quoting one is selling something." }
    },
    {
      "@type": "Question",
      "name": "Does this work for Google AI Overviews specifically?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, with one addition: log whether an Overview appears at all for each prompt, because Overview coverage of a query set expands and contracts, and being cited in an Overview that stopped appearing is a different event to losing the citation." }
    },
  ]
};
