---
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';

const posts = [
  {
    href: "/blog/best-digital-pr-agencies-b2b-saas",
    category: "Comparison",
    title: "Best Digital PR Agencies for B2B SaaS (2026)",
    description: "The field is enormous and most rankings are interchangeable, so this guide sorts by engagement model instead: what each type of agency is structurally built to deliver, with a named pick per model.",
    published: "Published July 2026",
    publishedISO: "2026-07-11T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/best-digital-pr-agencies-b2b-saas",
  },
  {
    href: "/blog/best-digital-pr-agencies-fintech-saas",
    category: "Comparison",
    title: "Best Digital PR Agencies for Fintech SaaS (2026)",
    description: "A comparison of seven agencies that earn editorial coverage and AI citations for fintech software companies, with selection criteria and honest fit notes.",
    published: "Published July 2026",
    publishedISO: "2026-07-10T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/best-digital-pr-agencies-fintech-saas",
  },
  {
    href: "/blog/best-digital-pr-agencies-cybersecurity",
    category: "Comparison",
    title: "Best Digital PR Agencies for Cybersecurity Companies (2026)",
    description: "Most agencies serving this category are communications firms. Digital PR is a different job, and only part of this list is built for it.",
    published: "Published July 2026",
    publishedISO: "2026-07-11T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/best-digital-pr-agencies-cybersecurity",
  },
  {
    href: "/blog/best-pr-agencies-data-infrastructure",
    category: "Comparison",
    title: "Best PR Agencies for Data Infrastructure Companies (2026)",
    description: "A short list, because this category punishes generalists: six agencies with genuine technical fluency, and a section on where data infrastructure citations actually come from.",
    published: "Published July 2026",
    publishedISO: "2026-07-11T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/best-pr-agencies-data-infrastructure",
  },
  {
    href: "/blog/best-pr-agencies-privacy-consent-saas",
    category: "Comparison",
    title: "Best PR Agencies for Privacy and Consent Management SaaS (2026)",
    description: "There is no dedicated privacy-tech PR agency. Here is what to hire instead, and why this category has a structural advantage most vendors waste.",
    published: "Published July 2026",
    publishedISO: "2026-07-11T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/best-pr-agencies-privacy-consent-saas",
  },
  {
    href: "/blog/best-pr-agencies-series-a-b-c-saas",
    category: "Comparison",
    title: "Best PR Agencies for Series A, B and C SaaS Companies (2026)",
    description: "What each funding stage actually needs from PR, and which agencies are built for it, because startup PR is three different jobs wearing one name.",
    published: "Published July 2026",
    publishedISO: "2026-07-11T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/best-pr-agencies-series-a-b-c-saas",
  },
  {
    href: "/blog/how-many-links-digital-pr-campaign",
    category: "Analysis",
    title: "How Many Links Should a Digital PR Campaign Get?",
    description: "The benchmarks that exist, why they contradict each other, the pitch maths nobody publishes, and why link counts now measure less than half the result.",
    published: "Published July 2026",
    publishedISO: "2026-07-11T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/how-many-links-digital-pr-campaign",
  },
  {
    href: "/blog/digital-pr-vs-link-building",
    category: "Analysis",
    title: "Digital PR vs Link Building: What You're Actually Buying",
    description: "The difference on the invoice, on the risk ledger, and on the balance sheet three years later, from someone who has sold both for fifteen years.",
    published: "Published July 2026",
    publishedISO: "2026-07-11T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/digital-pr-vs-link-building",
  },
  {
    href: "/blog/haro-alternatives",
    category: "Analysis",
    title: "HARO Alternatives in 2026: What Actually Replaced It",
    description: "The platforms that filled the gap, what each is genuinely good for, and the question every other guide avoids: what a reactive quote is actually worth now.",
    published: "Published July 2026",
    publishedISO: "2026-07-11T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/blog/haro-alternatives",
  },
];

const personAuthor = {
  "@type": "Person",
  "name": "Daniel Grainger",
  "url": "https://ranking-atlas.com/about",
  "jobTitle": "Founder",
  "worksFor": {
    "@type": "Organization",
    "name": "Ranking Atlas",
    "url": "https://ranking-atlas.com"
  },
  "sameAs": [
    "https://www.linkedin.com/in/daniel-grainger/",
    "https://ranking-atlas.com/about"
  ]
};

const itemListElement = posts.map((item, i) => ({
  "@type": "ListItem",
  "position": i + 1,
  "item": {
    "@type": "Article",
    "headline": item.title,
    "description": item.description,
    "url": item.schemaUrl,
    "author": personAuthor,
    "publisher": { "@type": "Organization", "name": "Ranking Atlas" },
    "datePublished": item.publishedISO,
    "dateModified": item.publishedISO,
  },
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Blog",
  "url": "https://ranking-atlas.com/blog/",
  "author": personAuthor,
  "publisher": {
    "@type": "Organization",
    "name": "Ranking Atlas",
    "url": "https://ranking-atlas.com"
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": itemListElement
  }
};
---

<Layout
  title="Blog | Ranking Atlas"
  description="Practical analysis, comparisons, and working notes on search and AI visibility."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Header -->
      <div class="mb-16">
        <Eyebrow label="Blog" />
        <h1 class="font-serif font-medium text-[2.25rem] md:text-[3rem] lg:text-[3.5rem] tracking-tight text-ink leading-[1.05] mb-5">
          Blog
        </h1>
        <p class="text-lg md:text-xl text-body leading-relaxed max-w-3xl">
          Practical analysis, comparisons, and working notes on search and AI visibility.
        </p>
      </div>

      <!-- Posts -->
      <section>
        <div class="grid sm:grid-cols-2 gap-6">
          {posts.map((item) => (
            <a href={item.href} class="group bg-white rounded-2xl shadow-card border border-[#0A0F1E]/8 p-8 hover:shadow-lg hover:border-[#1E3A8A]/40 transition-all duration-300 block flex flex-col">
              <div class="text-[10px] uppercase tracking-wider text-brand font-medium mb-3">{item.category}</div>
              <h3 class="font-serif font-semibold text-lg md:text-xl tracking-tight text-ink mb-3 leading-snug group-hover:text-brand transition-colors">
                {item.title}
              </h3>
              <p class="text-base text-body leading-relaxed mb-4">
                {item.description}
              </p>
              <p class="text-xs text-muted mb-5">{item.published}</p>
              <div class="mt-auto flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <img src="/assets/images/author/daniel-headshot.jpg" alt="Daniel Grainger" class="w-6 h-6 rounded-full object-cover" width="24" height="24" />
                  <span class="text-xs text-muted">Daniel Grainger</span>
                </div>
                <div class="text-xs text-brand font-medium group-hover:underline">Read the article →</div>
              </div>
            </a>
          ))}
        </div>
      </section>

    </div>
  </section>

</Layout>
