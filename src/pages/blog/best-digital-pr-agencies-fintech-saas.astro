  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Best Digital PR Agencies for Fintech SaaS (2026)",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Siege Media" },
    { "@type": "ListItem", "position": 2, "name": "Crackle PR" },
    { "@type": "ListItem", "position": 3, "name": "Fractl" },
