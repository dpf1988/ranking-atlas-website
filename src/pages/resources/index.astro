---
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import HandUnderline from '../../components/HandUnderline.astro';

const featuredResearch = [
  {
    href: "/resources/pet-premium",
    eyebrow: "Data Report",
    title: "Two months after the Renters' Rights Act, 7 in 10 rental listings still say no to pets",
    description: "Analysis of 15,522 live rental listings across 41 UK cities reveals the real barrier to renting with a pet is not cost. It is availability.",
    published: "Published July 2026",
    publishedISO: "2026-07-08T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/resources/pet-premium",
  },
  {
    href: "/resources/hs2-land-value-capture",
    eyebrow: "Data Report",
    title: "Can station-area land values pay for Burnham's HS2?",
    description: "Sixteen years of Land Registry data show that property prices near planned HS2 stations grew faster than England's average after route announcements. Whether that growth is large enough to fund reinstatement is a different question.",
    published: "Published July 2026",
    publishedISO: "2026-07-10T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/resources/hs2-land-value-capture",
  },
  {
    href: "/resources/hs2-property-prices",
    eyebrow: "Data Report",
    title: "The property data Andy Burnham doesn't want to see",
    description: "Homes near cancelled HS2 stations have outperformed England's average by up to 9 percentage points since Sunak axed the line. Areas near active HS2 construction have fallen sharply.",
    published: "Published June 2026",
    publishedISO: "2026-06-16T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/resources/hs2-property-prices",
  },
  {
    href: "/resources/generational-fraud",
    eyebrow: "Data Report",
    title: "Who Actually Gets Scammed in America?",
    description: "Federal fraud and survey data show sharp divides in who gets scammed, how often, and how much they lose.",
    published: "Published March 2026",
    publishedISO: "2026-03-15T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/resources/generational-fraud",
  },
  {
    href: "/resources/the-cost-of-authority",
    eyebrow: "Data Report",
    title: "The Hidden Economy Behind Google Rankings",
    description: "A six-year analysis of 140,000 publisher listings reveals how paid link markets expanded after repeated Google crackdowns.",
    published: "Published March 2026",
    publishedISO: "2026-03-01T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/resources/the-cost-of-authority",
  },
  {
    href: "/resources/saas-pricing-inflation",
    eyebrow: "Data Report",
    title: "Welcome to the SaaSpocalypse",
    description: "Software that can be vibe-coded by a small team has lost all pricing power, while AI-resistant SaaS categories raised entry-tier prices up to three times faster than inflation.",
    published: "Published April 2026",
    publishedISO: "2026-04-13T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/resources/saas-pricing-inflation",
  },
  {
    href: "/resources/ai-names-ict-experts",
    eyebrow: "Data Report",
    title: "One Woman for Every Ten: How AI Names the Experts in Tech",
    description: "2,286 individuals extracted from 2,520 AI responses across ChatGPT, Claude, Gemini, and Perplexity. Women made up 20.5% of named ICT experts against a 28% workforce baseline.",
    published: "Published April 2026",
    publishedISO: "2026-04-24T00:00:00+00:00",
    schemaUrl: "https://ranking-atlas.com/resources/ai-names-ict-experts",
  },
];

const orgAuthor = {
  "@type": "Organization",
  "name": "Ranking Atlas",
  "url": "https://ranking-atlas.com"
};

const itemListElement = featuredResearch.map((item, i) => ({
  "@type": "ListItem",
  "position": i + 1,
  "item": {
    "@type": "Article",
    "headline": item.title,
    "description": item.description,
    "url": item.schemaUrl,
    "author": orgAuthor,
    "publisher": orgAuthor,
    "datePublished": item.publishedISO,
    "dateModified": item.publishedISO,
  },
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Studies",
  "url": "https://ranking-atlas.com/resources",
  "publisher": orgAuthor,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": itemListElement
  }
};
---

<Layout
  title="Studies | Ranking Atlas"
  description="Original primary-source studies from Ranking Atlas. Data reports on property, technology, fraud, publishing, and AI citation patterns."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-6">

      <div>
        <Eyebrow label="Studies" />
        <h1 class="font-serif font-medium text-[1.75rem] md:text-[2.25rem] lg:text-[2.75rem] tracking-tight text-ink leading-[1.05] mb-5">
          <HandUnderline>Studies</HandUnderline> and reports <em class="font-normal italic text-ink/70">by Ranking Atlas</em>
        </h1>
        <p class="text-lg md:text-xl text-body leading-relaxed max-w-3xl">
          Original research on the markets, publishers, and answer engines that shape brand visibility.
        </p>
      </div>

      <hr class="border-t border-ink/8 my-14" />

      <div class="grid sm:grid-cols-2 gap-6">
        {featuredResearch.map((item) => (
          <a href={item.href} class="group bg-white rounded-2xl shadow-card border border-ink/8 p-8 hover:shadow-lg hover:border-brand/40 transition-all duration-300 block flex flex-col">
            <div class="text-[10px] uppercase tracking-wider text-brand font-medium mb-3">{item.eyebrow}</div>
            <h3 class="font-serif font-semibold text-lg md:text-xl tracking-tight text-ink mb-3 leading-snug group-hover:text-brand transition-colors">
              {item.title}
            </h3>
            <p class="text-base text-body leading-relaxed mb-4">
              {item.description}
            </p>
            <p class="text-xs text-muted mb-5">{item.published}</p>
            <div class="mt-auto flex items-center justify-between">
              <span class="text-xs text-muted">Ranking Atlas</span>
              <div class="text-xs text-brand font-medium group-hover:underline">Read the report →</div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

</Layout>
