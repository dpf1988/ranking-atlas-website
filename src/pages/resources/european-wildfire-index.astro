                </div>
                <div class={`w-[70px] text-right text-[11px] ${labelColor} shrink-0`}>{fmtNum(ha)}{isRecord2026 ? ' *' : ''}</div>
              </div>
            );
          })}
        </div>
        <p class="text-[11px] text-muted mt-3">* 2026 season to date (30 July). Source: EFFIS / Copernicus.</p>
      </div>

      <div class="space-y-6 text-body text-[15px] leading-[1.7]">
