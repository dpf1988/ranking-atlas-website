    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-semibold text-xl md:text-[1.5rem] tracking-tight text-ink leading-tight mb-6">France has already passed its worst wildfire year on record</h2>

      <!-- France annual bar chart -->
      <div class="bg-white rounded-md border border-ink/8 p-6 mb-8">
        <div class="font-serif font-semibold text-[16px] text-ink leading-tight mb-1">France: annual EFFIS-mapped burned area, 2006–2026 YTD</div>
        <div class="text-[12px] text-muted mb-6">Hectares. 2026 is season to date (30 July). Previous record year (2022) and 2026 highlighted.</div>
        <div class="space-y-1.5">
          {franceYears.map((year, i) => {
            const ha = franceHa[i];
            const maxHa = 91024;
            const widthPct = Math.max((ha / maxHa) * 100, 0.5);
            const isRecord2026 = year === 2026;
            const isRecord2022 = year === 2022;
            const barColor = isRecord2026 ? 'bg-accent' : isRecord2022 ? 'bg-accent/60' : 'bg-brand-slate/40';
            const labelColor = (isRecord2026 || isRecord2022) ? 'text-accent font-semibold' : 'text-muted';
            return (
