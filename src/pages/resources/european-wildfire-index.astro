<!-- Sortable table script -->
<script is:inline>
(function(){
  var table = document.getElementById('leagueTable');
  if (!table) return;
  var headers = table.querySelectorAll('th[data-sort]');
  var tbody = table.querySelector('tbody');
  var rows = Array.from(tbody.querySelectorAll('tr'));
  var currentSort = '';
  var ascending = false;

  headers.forEach(function(th) {
    th.addEventListener('click', function() {
      var key = th.getAttribute('data-sort');
      if (currentSort === key) { ascending = !ascending; }
      else { currentSort = key; ascending = key === 'country'; }

      rows.sort(function(a, b) {
        var aVal, bVal;
        if (key === 'country') {
          aVal = a.getAttribute('data-country');
          bVal = b.getAttribute('data-country');
          return ascending ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
        }
        if (key === 'decadeChange') {
          aVal = a.getAttribute('data-decade-change');
          bVal = b.getAttribute('data-decade-change');
          var parseDecade = function(v) {
            if (!v || v === '-') return -Infinity;
            return parseFloat(v.replace(/[+%,]/g, '').replace('−','-'));
          };
          aVal = parseDecade(aVal);
          bVal = parseDecade(bVal);
        } else {
          var attr = 'data-' + key.replace(/([A-Z])/g, function(m){ return '-' + m.toLowerCase(); });
          aVal = parseFloat(a.getAttribute(attr)) || 0;
          bVal = parseFloat(b.getAttribute(attr)) || 0;
        }
        return ascending ? aVal - bVal : bVal - aVal;
      });

      rows.forEach(function(row) { tbody.appendChild(row); });
      headers.forEach(function(h) { h.textContent = h.textContent.replace(/ [▲▼]/, ''); });
      th.textContent = th.textContent + (ascending ? ' ▲' : ' ▼');
    });
  });
})();
</script>

