---
import Layout from '../../layouts/Layout.astro';
import InstitutionalBio from '../../components/InstitutionalBio.astro';
import RelatedResearch from '../../components/RelatedResearch.astro';
import PullQuote from '../../components/PullQuote.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Can Station-Area Land Values Pay for Burnham's HS2?",
  "description": "Sixteen years of Land Registry data show that property prices near planned HS2 stations grew faster than England's average after route announcements. Whether that growth is large enough to fund reinstatement is a different question.",
  "url": "https://ranking-atlas.com/resources/hs2-land-value-capture",
  "image": "https://ranking-atlas.com/assets/images/resources/hs2-land-value-capture/hero.png",
  "author": { "@type": "Organization", "name": "Ranking Atlas", "url": "https://ranking-atlas.com" },
  "datePublished": "2026-07-10T00:00:00+00:00",
  "dateModified": "2026-07-10T00:00:00+00:00",
  "publisher": { "@type": "Organization", "name": "Ranking Atlas", "url": "https://ranking-atlas.com" }
};
---

<Layout
  title="Can Station-Area Land Values Pay for Burnham's HS2? | Ranking Atlas"
  description="Sixteen years of Land Registry data show that property prices near planned HS2 stations grew faster than England's average after route announcements. Whether that growth is large enough to fund reinstatement is a different question."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>

<div class="bg-white">

  <!-- 1. Hero -->
  <section class="pt-20 md:pt-28 pb-16 border-b border-[#0A0F1E]/8">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-xs uppercase tracking-wider text-brand font-medium mb-3 text-center">Data Report</div>
      <h1 class="font-serif font-medium text-[1.75rem] md:text-[2rem] lg:text-[2.25rem] tracking-tight text-ink leading-[1.15] mb-3 text-center">
        Can station-area land values pay for Burnham's HS2?
      </h1>
      <p class="font-serif italic text-[15px] md:text-[16px] leading-[1.55] text-body mt-2 mb-8 text-center">
        Sixteen years of Land Registry data show that property prices near planned HS2 stations grew faster than England's average after route announcements. Whether that growth is large enough to fund reinstatement is a different question.
      </p>

      <figure class="mb-8">
        <div class="relative w-full rounded-2xl overflow-hidden bg-[#FBFAF7] border border-[#0A0F1E]/8 aspect-[16/9] flex items-center justify-center">
          <img
            src="/assets/images/resources/hs2-land-value-capture/hero.png"
            alt="Indexed property price chart showing station-area growth versus England average from 2010 to 2026"
            class="w-full h-full object-cover"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <div class="hidden flex-col items-center justify-center text-muted p-8 text-center w-full h-full">
            <div class="text-sm text-[#64748B]">Station-area prices vs England, indexed to 100 at route announcement. Source: HM Land Registry.</div>
          </div>
        </div>
      </figure>

      <div class="bg-[#FBFAF7] border border-[#0A0F1E]/8 rounded-2xl p-5 mb-6">
        <p class="text-[13px] text-[#64748B]">Content Written By:</p>
        <p class="text-[13px] text-[#64748B]">Ranking Atlas</p>
        <p class="text-[13px] text-[#64748B]">Published July 2026</p>
        <p class="text-[13px] text-[#64748B]">10 min read</p>
      </div>

      <nav class="bg-[#FBFAF7] border border-[#0A0F1E]/8 rounded-2xl p-5" aria-label="Article sections">
        <p class="text-[14px] font-semibold text-ink mb-3">Navigation</p>
        <ul class="flex flex-col space-y-2 text-[14px]">
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#key-takeaways" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">Key takeaways</a></li>
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#anticipation-premium" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">Station areas grew faster than England after route announcements</a></li>
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#eastern-leg" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">The eastern leg recorded the largest premiums</a></li>
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#western-cancelled" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">Western cancelled areas show a mixed picture</a></li>
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#active-sites" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">Active construction sites diverged sharply</a></li>
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#per-home" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">What the premium is worth in current prices</a></li>
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#capture-question" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">The £36 billion question</a></li>
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#methodology" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">Methodology</a></li>
          <li class="flex items-center gap-2.5"><span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full border border-[#0A0F1E]/30 shrink-0"></span><a href="#download" class="text-brand hover:text-brand-dark hover:underline underline-offset-2">Download the data</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <!-- 2. Key takeaways -->
  <section id="key-takeaways" class="py-16 bg-[#FBFAF7] border-b border-[#0A0F1E]/8">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-semibold text-xl md:text-[1.5rem] tracking-tight text-ink leading-tight mb-6">Key takeaways</h2>
      <ul class="space-y-2 list-disc pl-6 text-body text-[15px] leading-[1.7]">
        <li><strong>Five of seven cancelled station areas grew faster than England</strong> between their HS2 route announcement and Q3 2023 (pre-cancellation). The remaining two underperformed by 4 to 7 percentage points.</li>
        <li><strong>Toton, the planned East Midlands hub, recorded a +40.5 percentage point anticipation premium.</strong> Its median price doubled between Q1 2013 and Q3 2023, against 59.7% growth for England over the same window.</li>
        <li><strong>Manchester Piccadilly-area prices grew 90.9%,</strong> outpacing England by 31.2 percentage points. Sheffield Midland outpaced by 20.2 points. Manchester Airport by 10.4 points.</li>
        <li><strong>Old Oak Common, the active London super-hub, underperformed England by 4.8 percentage points</strong> over the same announcement-to-cancellation window and has since fallen a further 18.8%.</li>
        <li><strong>The value of station-area uplift has not previously been quantified at postcode-district level.</strong> This study is the first to index every planned HS2 station area against England from route announcement to cancellation using Land Registry transaction data.</li>
        <li><strong>Approximately 15.4 million transactions</strong> across 17 years of HM Land Registry Price Paid Data underpin the analysis.</li>
      </ul>
    </div>
  </section>

  <!-- 3. Overview -->
  <section class="py-16 border-b border-[#0A0F1E]/8">
    <div class="max-w-3xl mx-auto px-6">
      <div class="space-y-6 text-body text-[15px] leading-[1.7]">
        <p>
          Andy Burnham's pledge to revive HS2's northern leg between Birmingham and Manchester, if he becomes Prime Minister, rests on a financing idea: that the increase in land values around new stations can help pay for the railway. Under Burnham's proposal, approximately £36 billion could be raised through land-value capture mechanisms applied to station-area property.
        </p>
        <p>
          The estimated cost of HS2 Phase 2 is approximately £102.7 billion. Whether station-area land values have historically risen enough to make that arithmetic plausible is a question that can be tested against <a href="/" class="text-brand hover:text-brand-dark underline underline-offset-2">open government data</a>.
        </p>
        <p>
          <a href="/" class="text-brand hover:text-brand-dark underline underline-offset-2">Ranking Atlas</a> analysed 16 years of HM Land Registry Price Paid Data, covering every residential property transaction in England from Q1 2010 to Q1 2026. We indexed quarterly median prices for nine station-area postcode groups against the England-wide median, measured from each area's HS2 route announcement date.
        </p>
        <p>
          This is a companion study to our <a href="/resources/hs2-property-prices" class="text-brand hover:text-brand-dark underline underline-offset-2">earlier analysis of post-cancellation property prices near HS2 stations</a>, which found that cancelled areas outperformed England after the northern leg was axed.
        </p>
        <p class="font-semibold text-ink">
          The question here is different: did station-area prices rise faster than England before cancellation, and if so, by how much?
        </p>
      </div>
    </div>
  </section>

  <!-- 4. Anticipation premium -->
  <section id="anticipation-premium" class="py-16 bg-[#FBFAF7] border-b border-[#0A0F1E]/8">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-semibold text-xl md:text-[1.5rem] tracking-tight text-ink leading-tight mb-6">Station areas grew faster than England after route announcements</h2>

      <div class="space-y-6 text-body text-[15px] leading-[1.7] mb-10">
        <p>
          We define the "anticipation premium" as the difference in percentage-point growth between a station area and England over the window from route announcement to Q3 2023 (the last full quarter before cancellation). A positive premium means the station area outgrew England; a negative premium means it underperformed.
        </p>
        <p>
          Phase 1 stations (Old Oak Common, Birmingham Curzon Street) use a Q1 2012 baseline, when the Phase 1 route was confirmed. Phase 2 stations use Q1 2013, when the Phase 2 route was announced on 28 January 2013.
        </p>
      </div>

      <!-- Anticipation premium bar chart -->
      <div class="bg-white rounded-2xl border border-[#0A0F1E]/8 p-6 mb-10">
        <div class="font-serif font-semibold text-[16px] text-ink leading-tight mb-1">Anticipation premium by station area</div>
        <div class="text-[12px] text-[#64748B] mb-4">Difference in percentage-point growth between station area and England, route announcement to Q3 2023. Positive values indicate the station area outgrew England.</div>
        <div class="relative w-full" style="height:380px">
          <canvas id="chartPremium" role="img" aria-label="Horizontal bar chart showing anticipation premiums. Toton +40.5pp, Manchester Piccadilly +31.2pp, Sheffield +20.2pp, Manchester Airport +10.4pp, Leeds +7.6pp, Staffs corridor -4.0pp, Old Oak Common -4.8pp, Crewe -7.1pp."></canvas>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4 text-[12px] text-[#475569]">
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#1E3A8A"></span>Cancelled station</div>
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#64748B"></span>Active station</div>
        </div>
      </div>

      <div class="space-y-6 text-body text-[15px] leading-[1.7]">
        <p>
          Five of the seven cancelled station areas recorded a positive anticipation premium. Toton, the planned East Midlands hub on the eastern leg, recorded the largest at +40.5 percentage points. Manchester Piccadilly was second at +31.2 points.
        </p>
        <p>
          Two cancelled areas, Crewe and the Staffordshire corridor, underperformed England. Old Oak Common, the active London super-hub, also underperformed over the announcement-to-cancellation window.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Eastern leg -->
  <section id="eastern-leg" class="py-16 border-b border-[#0A0F1E]/8">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-semibold text-xl md:text-[1.5rem] tracking-tight text-ink leading-tight mb-6">The eastern leg recorded the largest premiums</h2>

      <div class="space-y-6 text-body text-[15px] leading-[1.7] mb-10">
        <p>
          The three eastern-leg station areas, all cancelled in 2023, collectively outperformed England by between 7.6 and 40.5 percentage points over the announcement-to-cancellation window.
        </p>
      </div>

      <!-- Eastern leg indexed chart -->
      <div class="bg-white rounded-2xl border border-[#0A0F1E]/8 p-6 mb-10">
        <div class="font-serif font-semibold text-[16px] text-ink leading-tight mb-1">Eastern leg: indexed price growth vs England</div>
        <div class="text-[12px] text-[#64748B] mb-4">Quarterly median price indexed to 100 at Q1 2013 (Phase 2 route announcement). Half-yearly data points shown.</div>
        <div class="relative w-full" style="height:360px">
          <canvas id="chartEastern" role="img" aria-label="Line chart showing Toton, Sheffield, Leeds, and England indexed prices from 2010 to 2026, with Toton reaching approximately 196 by Q1 2026 against England at 154."></canvas>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4 text-[12px] text-[#475569]">
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#1E3A8A"></span>Toton / East Midlands hub</div>
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#047857"></span>Sheffield Midland</div>
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#B45309"></span>Leeds</div>
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#94A3B8"></span>England</div>
        </div>
      </div>

      <div class="space-y-6 text-body text-[15px] leading-[1.7]">
        <p>
          Toton's median price doubled over the decade. In Q1 2013, the median transaction around the planned East Midlands hub was £132,750. By Q3 2023 it had reached £265,500, a 100.2% increase. England grew 59.7% over the same period.
        </p>
        <p class="italic text-[14px] text-muted">
          Toton Q1 2013 median: £132,750. Q3 2023 median: £265,500. Growth: 100.2%. England growth: 59.7%. Premium: +40.5pp.
        </p>
        <p>
          Sheffield Midland-area properties grew 79.9% against England's 59.7%, a premium of +20.2 points. Leeds grew 67.3%, outpacing England by 7.6 points. All three eastern-leg groups maintained quarterly transaction counts above 50 throughout the period.
        </p>
        <p>
          The eastern leg was cancelled alongside the western leg in October 2023. Since cancellation, all three eastern-leg areas have seen modest price declines of 1 to 9 percentage points. The anticipation premium accumulated over a decade has not reversed, but it is no longer growing.
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Western cancelled -->
  <section id="western-cancelled" class="py-16 bg-[#FBFAF7] border-b border-[#0A0F1E]/8">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-semibold text-xl md:text-[1.5rem] tracking-tight text-ink leading-tight mb-6">Western cancelled areas show a mixed picture</h2>

      <div class="space-y-6 text-body text-[15px] leading-[1.7] mb-10">
        <p>
          The four cancelled western-leg stations split into two pairs. Manchester Piccadilly and Manchester Airport outperformed England. Crewe and the Staffordshire corridor underperformed.
        </p>
      </div>

      <!-- Western leg indexed chart -->
      <div class="bg-white rounded-2xl border border-[#0A0F1E]/8 p-6 mb-10">
        <div class="font-serif font-semibold text-[16px] text-ink leading-tight mb-1">Western cancelled areas: indexed price growth vs England</div>
        <div class="text-[12px] text-[#64748B] mb-4">Quarterly median price indexed to 100 at Q1 2013 (Phase 2 route announcement). Half-yearly data points shown.</div>
        <div class="relative w-full" style="height:360px">
          <canvas id="chartWestern" role="img" aria-label="Line chart showing Manchester Piccadilly, Manchester Airport, Crewe, Staffs corridor, and England indexed prices from 2010 to 2026."></canvas>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4 text-[12px] text-[#475569]">
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#1E3A8A"></span>Manchester Piccadilly</div>
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#047857"></span>Manchester Airport</div>
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#B45309"></span>Crewe</div>
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#B91C1C"></span>Staffs corridor</div>
          <div class="flex items-center gap-1.5"><span aria-hidden="true" class="inline-block w-2.5 h-2.5 rounded-sm" style="background:#94A3B8"></span>England</div>
        </div>
      </div>

      <div class="space-y-6 text-body text-[15px] leading-[1.7]">
        <p>
          Manchester Piccadilly-area prices grew 90.9% between Q1 2013 and Q3 2023, compared with 59.7% for England. Much of this reflects Manchester city centre's broader regeneration, not HS2 alone. The +31.2 percentage point premium is the second largest in the study.
        </p>
        <p>
          Manchester Airport districts (M22, SK9) grew 70.0%, beating England by 10.4 points. These postcodes include Wilmslow and parts of Bramhall, areas with strong independent price momentum.
        </p>
        <p>
          Crewe, the planned northern hub, grew only 52.5% against England's 59.7%. The Staffordshire corridor grew 55.7%. Both underperformed by 4 to 7 percentage points. These are lower-value markets where HS2 route proximity did not translate into faster growth relative to the national median.
        </p>
        <p>
          Post-cancellation, the pattern flipped. As our <a href="/resources/hs2-property-prices" class="text-brand hover:text-brand-dark underline underline-offset-2">companion cancellation study</a> showed, Crewe outperformed England by +9.1 percentage points after the northern leg was axed, the strongest post-cancellation performance of any station area.
        </p>
      </div>
    </div>
  </section>

  <!-- 7. Active sites -->
  <section id="active-sites" class="py-16 border-b border-[#0A0F1E]/8">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-semibold text-xl md:text-[1.5rem] tracking-tight text-ink leading-tight mb-6">Active construction sites diverged sharply</h2>

      <div class="space-y-6 text-body text-[15px] leading-[1.7]">
        <p>
          Old Oak Common, the London super-hub still under active construction, grew 58.0% between Q1 2012 and Q3 2023. England grew 62.9% over the same window, giving Old Oak Common a negative anticipation premium of -4.8 percentage points.
        </p>
        <p>
          Since Q3 2023, Old Oak Common prices have fallen a further 18.8%. The combined effect of construction blight and broader London softening has left the area 28 index points below its Q1 2012 starting level in real relative terms.
        </p>
        <p class="italic text-[14px] text-muted">
          Old Oak Common Q1 2012 median: £327,500. Q3 2023 median: £517,500. Q1 2026 median: £420,000. Announcement-to-cancellation growth: 58.0%. England: 62.9%. Premium: -4.8pp. Post-cancellation: -18.8%.
        </p>
        <p>
          Birmingham Curzon Street recorded a +80.9pp premium, but with only 41 transactions in its Q1 2012 baseline quarter and 19 in Q1 2026, the figure is unreliable. The existing <a href="/resources/hs2-property-prices" class="text-brand hover:text-brand-dark underline underline-offset-2">cancellation study</a> excluded Birmingham for the same reason. We report it for completeness but exclude it from headline claims.
        </p>
      </div>
    </div>
  </section>

  <!-- 8. Per-home figures -->
  <section id="per-home" class="py-16 bg-[#FBFAF7] border-b border-[#0A0F1E]/8">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-semibold text-xl md:text-[1.5rem] tracking-tight text-ink leading-tight mb-6">What the premium is worth in current prices</h2>

      <div class="space-y-6 text-body text-[15px] leading-[1.7] mb-10">
        <p>
          To translate the anticipation premium into a per-home figure, we multiply each station area's premium (as a ratio) by its current Q1 2026 median price. This is illustrative arithmetic, not a forecast. It shows what the historic growth differential represents if applied to a home at today's median value.
        </p>
      </div>

      <div class="overflow-x-auto bg-white rounded-2xl border border-[#0A0F1E]/8 mb-10">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="border-b border-[#0A0F1E]/8 bg-[#FBFAF7]">
              <th class="px-4 py-3 font-semibold text-ink">Station area</th>
              <th class="px-4 py-3 font-semibold text-ink text-right">Growth</th>
              <th class="px-4 py-3 font-semibold text-ink text-right">England</th>
              <th class="px-4 py-3 font-semibold text-ink text-right">Premium</th>
              <th class="px-4 py-3 font-semibold text-ink text-right">Current median</th>
              <th class="px-4 py-3 font-semibold text-ink text-right">Per-home £</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#0A0F1E]/6">
            <tr class="hover:bg-[#FBFAF7] transition-colors">
              <td class="px-4 py-3 font-medium text-ink">Toton / East Midlands hub</td>
              <td class="px-4 py-3 text-right text-[#64748B]">100.2%</td>
              <td class="px-4 py-3 text-right text-[#64748B]">59.7%</td>
              <td class="px-4 py-3 text-right font-semibold text-[#15803D]">+40.5pp</td>
              <td class="px-4 py-3 text-right text-[#64748B]">£260,000</td>
              <td class="px-4 py-3 text-right font-semibold text-[#15803D]">£105,365</td>
            </tr>
            <tr class="hover:bg-[#FBFAF7] transition-colors">
              <td class="px-4 py-3 font-medium text-ink">Manchester Piccadilly</td>
              <td class="px-4 py-3 text-right text-[#64748B]">90.9%</td>
              <td class="px-4 py-3 text-right text-[#64748B]">59.7%</td>
              <td class="px-4 py-3 text-right font-semibold text-[#15803D]">+31.2pp</td>
              <td class="px-4 py-3 text-right text-[#64748B]">£214,000</td>
              <td class="px-4 py-3 text-right font-semibold text-[#15803D]">£66,865</td>
            </tr>
            <tr class="hover:bg-[#FBFAF7] transition-colors">
              <td class="px-4 py-3 font-medium text-ink">Sheffield Midland</td>
              <td class="px-4 py-3 text-right text-[#64748B]">79.9%</td>
              <td class="px-4 py-3 text-right text-[#64748B]">59.7%</td>
              <td class="px-4 py-3 text-right font-semibold text-[#15803D]">+20.2pp</td>
              <td class="px-4 py-3 text-right text-[#64748B]">£160,000</td>
              <td class="px-4 py-3 text-right font-semibold text-[#15803D]">£32,349</td>
            </tr>
            <tr class="hover:bg-[#FBFAF7] transition-colors">
              <td class="px-4 py-3 font-medium text-ink">Manchester Airport</td>
              <td class="px-4 py-3 text-right text-[#64748B]">70.0%</td>
              <td class="px-4 py-3 text-right text-[#64748B]">59.7%</td>
              <td class="px-4 py-3 text-right font-semibold text-[#15803D]">+10.4pp</td>
