---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title = 'Ranking Atlas (Official) — Research-Led Editorial Campaigns',
  description = 'Ranking Atlas is the official site for research-led digital PR. We turn proprietary data, commissioned research, and original analysis into editorial studies that earn authoritative coverage.',
  noindex = false,
  ogImage = '/og-default.png',
} = Astro.props;

// Canonical: site origin + pathname, with any trailing slash stripped from
// non-root paths and any query string discarded. Page-level overrides are
// possible via the head slot.
const rawPath = Astro.url.pathname;
const canonicalPath = rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '').replace(/\.html$/, '');
const canonicalHref = `https://ranking-atlas.com${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ranking Atlas (Official)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={`https://ranking-atlas.com${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://ranking-atlas.com${ogImage}`} />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Ranking Atlas",
      "url": "https://ranking-atlas.com",
      "description": "Ranking Atlas is a specialist data campaigns firm. We turn proprietary data, commissioned research, and original analysis into editorial studies that earn authoritative coverage.",
      "knowsAbout": ["Data Campaigns", "Editorial Research", "Commissioned Research", "Proprietary Data Analysis", "Editorial Coverage", "Citation Equity", "AI Search Visibility", "Digital PR", "Journalist Outreach"],
      "logo": "https://ranking-atlas.com/Logo.png",
      "founder": {
        "@type": "Person",
        "name": "Daniel Grainger",
        "url": "https://ranking-atlas.com/about",
        "sameAs": [
          "https://www.linkedin.com/in/daniel-grainger/"
        ]
      },
      "sameAs": [
        "https://www.linkedin.com/company/ranking-atlas/"
      ]
    }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Source+Serif+4:wght@500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6XN48YX93J"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6XN48YX93J', { anonymize_ip: true });
    </script>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="bg-bg-paper font-sans antialiased min-h-screen">
    <Navbar />
    <slot />
    <Footer />
    <script is:inline>
      document.addEventListener('click', function(e) {
        var el = e.target.closest('[data-cta]');
        if (!el) return;
        if (typeof gtag !== 'function') return;
        gtag('event', 'cta_click', {
          cta_type: el.getAttribute('data-cta'),
          cta_label: el.getAttribute('data-cta-label'),
          page_path: location.pathname,
          destination: el.getAttribute('href')
        });
      });
    </script>
  </body>
</html>
